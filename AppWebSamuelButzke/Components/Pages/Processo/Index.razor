@page "/processos"

@using AppWebSamuelButzke.Model
@using AppWebSamuelButzke.DAO

@inject ProcessoDAO ProcessoDAO

<PageTitle>Processos - Sistema de Controle de Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Consulta de Processos</h2>
    </div>

    <div>
        <a href="/processos/cadastro" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Novo Processo
        </a>
    </div>
</div>

<div class="custom-table-card">

    <div class="table-responsive">
        
        
        <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Número</th>
                <th>Interessado</th>
                <th>Assunto</th>
                <th>Situação</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (erro is not null)
            {
                <tr>
                    <td colspan="6" class="text-danger">@erro</td>
                </tr>
            }
            else if (processos.Count == 0)
            {
                <tr>
                    <td colspan="6">Nenhum processo encontrado.</td>
                </tr>
            }
            else
            {
                @foreach (var processo in processos)
                {
                    <tr>
                        <td>@processo.Id</td>
                        <td>@processo.Numero</td>
                        <td>@processo.Interessado</td>
                        <td>@processo.Assunto</td>
                        <td>@processo.Situacao</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="@($"/processos/editar/{processo.Id}")"
                                       class="btn btn-light border text-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="@($"/processos/excluir/{processo.Id}")"
                                       class="btn btn-light border text-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                    </tr>
                }
            }
        </tbody>

        </table>

    </div>
</div>

@code {
    private List<Processo> processos = new();
    private string? erro;

    protected override void OnInitialized()
    {
        try
        {
            processos = ProcessoDAO.Listar();
        }
        catch (Exception)
        {
            erro = "Não foi possível carregar os processos. Verifique a conexão com o banco de dados.";
        }
    }
}
