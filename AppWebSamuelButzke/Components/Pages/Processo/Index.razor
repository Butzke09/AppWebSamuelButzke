@page "/processos"

@using AppWebSamuelButzke.Model
@using AppWebSamuelButzke.DAO

@inject ProcessoDAO ProcessoDAO

<PageTitle>Processos - Sistema de Controle de Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Consulta de Processos</h2>
        <p class="text-muted mb-0">Gerencie e consulte os processos cadastrados.</p>
    </div>

    <a href="/processos/cadastro" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Novo Processo
    </a>
</div>

<div class="custom-table-card">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">

            <thead>
                <tr>
                    <th>Id</th>
                    <th>Número</th>
                    <th>Interessado</th>
                    <th>Assunto</th>
                    <th>Situação</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>

            <tbody>
                @if (erro is not null)
                {
                    <tr>
                        <td colspan="6" class="text-center text-danger py-4">
                            <i class="bi bi-exclamation-circle"></i>
                            @erro
                        </td>
                    </tr>
                }
                else if (processos.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                            Nenhum processo encontrado.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var processo in processos)
                    {
                        <tr>
                            <td>@processo.Id</td>
                            <td class="fw-semibold">@processo.Numero</td>
                            <td>@processo.Interessado</td>
                            <td>@processo.Assunto</td>

                            <td>
                                <span class="badge rounded-pill
                                    @(processo.Situacao == "Aberto" ? "bg-success" :
                                      processo.Situacao == "Arquivado" ? "bg-secondary" :
                                      processo.Situacao == "Pendente" ? "bg-warning text-dark" :
                                      processo.Situacao == "Concluido" ? "bg-primary" :
                                      "bg-info text-dark")">
                                    @processo.Situacao
                                </span>
                            </td>

                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group"
                                     aria-label="Ações do processo">

                                    <a href="@($"/processos/visualizar/{processo.Id}")"
                                       class="btn btn-light border text-secondary"
                                       title="Visualizar"
                                       aria-label="Visualizar processo">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a href="@($"/processos/editar/{processo.Id}")"
                                       class="btn btn-light border text-primary"
                                       title="Editar"
                                       aria-label="Editar processo">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a href="@($"/processos/excluir/{processo.Id}")"
                                       class="btn btn-light border text-danger"
                                       title="Excluir"
                                       aria-label="Excluir processo">
                                        <i class="bi bi-trash"></i>
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>
</div>

@code {
    private List<Processo> processos = new();
    private string? erro;

    protected override void OnInitialized()
    {
        try
        {
            processos = ProcessoDAO.Listar();
        }
        catch (Exception)
        {
            erro = "Não foi possível carregar os processos. Verifique a conexão com o banco de dados.";
        }
    }
}
